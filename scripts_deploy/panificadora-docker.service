[Unit]
Description=Padaria PDV Docker Compose (LEGADO - prefira padaria-pdv.service)
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/bruno/panificadora
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down --remove-orphans
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
